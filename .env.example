# ===========================================================================
# Fekerte environment. `pnpm dev` copies this to .env if missing.
# Everything runs locally with these defaults: mock WhatsApp / LLM / STT,
# browser-only voice, manual billing, local Postgres. Real providers switch on
# by setting their keys. Full reference: README.md → "Environment variables".
#
# Set by the platform, never by you: NODE_ENV, NEXT_RUNTIME, PORT (Railway/Fly),
# VERCEL_GIT_COMMIT_SHA / RAILWAY_GIT_COMMIT_SHA / FLY_IMAGE_REF (release id), CI.
# ===========================================================================

# --- Core --------------------------------------------------------------------
# Postgres. Supabase: use the session pooler (port 5432) or the direct
# connection; with the transaction pooler (6543) also set DATABASE_PREPARE=false.
DATABASE_URL=postgres://fekerte:fekerte@localhost:5432/fekerte
DATABASE_POOL_MAX=10
# DATABASE_PREPARE=false
# Used by `pnpm test` / `pnpm eval` — DROPPED AND RECREATED on every run.
TEST_DATABASE_URL=postgres://fekerte:fekerte@localhost:5432/fekerte_test

# Public URL of the web app (WhatsApp links, magic links, payment links).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters (`openssl rand -hex 32`). Signs sessions, manage links,
# web-chat sessions, voice tokens, payment links. REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string-0123456789abcdef
# Bearer token for /api/cron/jobs (Vercel Cron / any scheduler, every minute).
CRON_SECRET=dev-cron-secret
# Dev only: how often scripts/dev-cron.ts pings the cron endpoint.
# DEV_CRON_INTERVAL_MS=20000

LOG_LEVEL=info
# LOG_FORMAT=pretty

# --- Observability -----------------------------------------------------------
# Errors from logger.error + Next.js request errors are sent to Sentry when set.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# /api/health reports "degraded" when the oldest due job waits longer than this.
# HEALTH_MAX_JOB_LAG_SECONDS=600

# --- Abuse & cost protection ---------------------------------------------------
# memory | postgres. Default: postgres in production (shared across serverless
# instances), memory in development.
# RATE_LIMIT_STORE=postgres
# AI replies per WhatsApp / web-chat conversation per hour before handing to staff.
# AI_MAX_REPLIES_PER_HOUR=40
# AI-answered calls per caller number per hour before ringing the business instead.
# AI_MAX_CALLS_PER_HOUR=6

# --- Auth ----------------------------------------------------------------------
# local (built-in email+password; magic links printed to the server log) | supabase
AUTH_PROVIDER=local
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seeded super admin (pnpm db:seed). Change before seeding a real deployment.
SEED_ADMIN_EMAIL=admin@fekerte.app
SEED_ADMIN_PASSWORD=admin12345

# --- WhatsApp --------------------------------------------------------------------
# mock | meta
WHATSAPP_PROVIDER=mock
# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta)
# WHATSAPP_ACCESS_TOKEN=           # permanent system-user token with whatsapp_business_messaging
# WHATSAPP_APP_SECRET=             # Meta app secret: verifies X-Hub-Signature-256 on webhooks
# WHATSAPP_VERIFY_TOKEN=           # any string; enter the same value in the Meta webhook config
# WHATSAPP_PHONE_NUMBER_ID=        # default sender (each business can set its own in AI settings)
# WHATSAPP_GRAPH_VERSION=v24.0     # verify the current version in Meta's changelog

# --- AI receptionist (LLM) ---------------------------------------------------------
# anthropic | openai | mock. Unset = anthropic if ANTHROPIC_API_KEY is set, else mock.
# LLM_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort for chat and voice turns (low | medium | high). Receptionist work is latency-sensitive.
# LLM_EFFORT=low
# LLM_VOICE_EFFORT=low
# OpenAI-compatible alternative (LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# --- Speech-to-text (WhatsApp voice notes) -------------------------------------------
# mock | openai (any OpenAI-compatible /audio/transcriptions endpoint)
STT_PROVIDER=mock
# STT_MODEL=gpt-4o-transcribe
# STT_API_KEY=                     # defaults to OPENAI_API_KEY
# STT_BASE_URL=                    # defaults to OPENAI_BASE_URL

# --- Evals -----------------------------------------------------------------------------
# EVAL_PROVIDER=mock               # mock | anthropic | openai
# EVAL_DATABASE_URL=               # defaults to TEST_DATABASE_URL (reset on every run!)
# EVAL_FILTER=ar-                  # only scenarios whose id contains this
# EVAL_MIN_PASS_RATE=0.9           # `pnpm eval` exits non-zero below this

# --- Voice (apps/voice) ------------------------------------------------------------------
# Public base URL of the voice server (Twilio webhooks + WebSockets). https in production.
VOICE_PUBLIC_URL=http://localhost:3001
# Browser call simulator connects here (defaults to VOICE_PUBLIC_URL).
NEXT_PUBLIC_VOICE_URL=http://localhost:3001
# Local port (Railway/Fly inject PORT, which takes precedence).
VOICE_PORT=3001
# realtime | cascade (per-business setting overrides; degrades to what keys allow, then Twilio <Gather>)
VOICE_PIPELINE=cascade
# VOICE_SILENCE_MS=550             # end-of-utterance silence for the cascade STT
# VOICE_JOB_WORKER=true            # the voice server also drains the job queue
# VOICE_JOB_INTERVAL_MS=15000

# Twilio (phone numbers, Media Streams, transfer, recording)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=               # also verifies X-Twilio-Signature
# TWILIO_RECORD_CALLS=true
# <Say> voices for the <Gather> fallback pipeline:
# TWILIO_SAY_VOICE_AR=Polly.Zeina
# TWILIO_SAY_VOICE_EN=Polly.Joanna
# TWILIO_SAY_VOICE_FR=Polly.Lea

# OpenAI Realtime (speech-to-speech) and streaming transcription (cascade STT)
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# OPENAI_STT_MODEL=gpt-4o-transcribe

# Text-to-speech for the cascade pipeline: elevenlabs | openai | none (auto-detected from keys)
# TTS_PROVIDER=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=             # choose a Levantine/Lebanese Arabic voice
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# --- Billing & payments ------------------------------------------------------------------
# manual (admins issue invoices and mark them paid with a reference + receipt) |
# mock_link (demo deposit links to /pay/mock — never charges anyone)
PAYMENTS_PROVIDER=manual
# Demo payment page is disabled in production unless this is true.
# ALLOW_MOCK_PAYMENTS=false
# Shown to owners on unpaid invoices.
PAYMENT_INSTRUCTIONS="Pay by bank transfer (IBAN LB00 0000 0000 0000 0000 0000 0000), cash, or Whish/OMT wallet to +961 70 000 000. Mention the reference."
# Printed on invoices.
BILLING_COMPANY_DETAILS="Fekerte · Beirut, Lebanon · billing@fekerte.app"
# Days after the due date before AI features pause for an unpaid invoice.
BILLING_GRACE_DAYS=7
# Issue monthly invoices automatically on the 1st (Beirut time) for active businesses.
BILLING_AUTO_INVOICE=true
# AI pauses when monthly usage reaches this multiple of the plan's included amount
# (overage below the cap is allowed and billed). 0 disables the cap.
USAGE_HARD_CAP_MULTIPLIER=3

# --- Growth -----------------------------------------------------------------------------
# Minutes after a completed visit before the WhatsApp rating request (moved into 10:00–20:00).
REVIEW_REQUEST_DELAY_MINUTES=120

# --- File storage (payment receipts) ------------------------------------------------------
# local | supabase
STORAGE_PROVIDER=local
# LOCAL_UPLOAD_DIR=.data/uploads
# SUPABASE_URL=                    # defaults to NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=       # server-only; never expose to the browser
# SUPABASE_STORAGE_BUCKET=fekerte-private

# --- Marketing site / live demo -------------------------------------------------------------
# Business used by the public /demo page (chat + browser call; rate-limited, text mode).
DEMO_BUSINESS_SLUG=demo-dental
# Let the public demo call use the paid audio pipeline (OpenAI/ElevenLabs). Off by default.
DEMO_ALLOW_AUDIO=false

# --- End-to-end tests (apps/web, Playwright) ------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
# PLAYWRIGHT_CHROMIUM_PATH=        # use a preinstalled Chromium instead of Playwright's
